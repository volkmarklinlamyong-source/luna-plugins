{
  "name": "@espeon/luna-plugins",
  "description": "Plugins for Luna (Tidal mod client)",
  "type": "module",
  "scripts": {
    "watch": "concurrently npm:esWatch npm:serve",
    "build": "rimraf ./dist && tsx esbuild.config.ts",
    "esWatch": "rimraf ./dist && tsx ./esbuild.config.ts --watch",
    "serve": "http-server ./dist -p 3000 -s --cors -c-1"
  },
  "devDependencies": {
    "@inrixia/helpers": "^3.21.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "electron": "^40.8.5",
    "http-server": "^14.1.1",
    "luna": "github:Inrixia/TidaLuna",
    "oby": "^15.1.2",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
